# GraphFlow local development environment variables.
#
# Copy this file to `.env`, then replace every `change-me-*` placeholder
# with a value of your choice before running `docker compose up -d`.
# Compose loads `.env` automatically and will fail fast if a required
# variable is unset.
#
# This file intentionally ships no literal passwords so it is safe to
# commit. Choose throwaway values for local development; the compose
# stack is not meant to be exposed beyond localhost.

# --- Neo4j (graph destination) -------------------------------------
NEO4J_PASSWORD=change-me-in-local-env
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Postgres (metadata / future API state) ------------------------
POSTGRES_USER=graphflow
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=graphflow
POSTGRES_PORT=5432

# --- Redis (future worker queue) -----------------------------------
REDIS_PORT=6379

# --- Integration test runner ---------------------------------------
# Setting these makes `pytest -m integration` run against the compose
# stack instead of skipping. Keep the URI/username/DSN lines; replace
# the password placeholder with whatever you chose above.
GRAPHFLOW_NEO4J_URI=bolt://localhost:7687
GRAPHFLOW_NEO4J_USERNAME=neo4j
GRAPHFLOW_NEO4J_PASSWORD=change-me-in-local-env

GRAPHFLOW_POSTGRES_DSN=postgresql://graphflow:change-me-in-local-env@localhost:5432/graphflow
GRAPHFLOW_REDIS_URL=redis://localhost:6379/0
