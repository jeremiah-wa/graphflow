# GraphFlow local development environment variables.
#
# Copy this file to `.env` and adjust values before running
# `docker compose up -d`. Compose will load `.env` automatically.
# None of these values are secrets worth protecting for a throwaway
# local stack, but all of them are overridable so the same file can be
# used for CI and for local work.

# --- Neo4j (graph destination) -------------------------------------
# Matches the `NEO4J_AUTH` setting in docker-compose.yml.
NEO4J_PASSWORD=graphflow
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Postgres (metadata / future API state) ------------------------
POSTGRES_USER=graphflow
POSTGRES_PASSWORD=graphflow
POSTGRES_DB=graphflow
POSTGRES_PORT=5432

# --- Redis (future worker queue) -----------------------------------
REDIS_PORT=6379

# --- Integration test runner ---------------------------------------
# Setting these makes `pytest -m integration` run against the compose
# stack instead of skipping. They match the compose defaults above.
GRAPHFLOW_NEO4J_URI=bolt://localhost:7687
GRAPHFLOW_NEO4J_USERNAME=neo4j
GRAPHFLOW_NEO4J_PASSWORD=graphflow

GRAPHFLOW_POSTGRES_DSN=postgresql://graphflow:graphflow@localhost:5432/graphflow
GRAPHFLOW_REDIS_URL=redis://localhost:6379/0
